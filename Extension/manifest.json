{
"manifest_version": 3,
"name": "Recspot",
"version": "1.0",
"description": "A Chrome extension that recommends songs based on the current song playing on Spotify.",
"permissions": [
    "activeTab",
    "scripting"
],
"host_permissions": [
    "https://open.spotify.com/*",
    "http://127.0.0.1:5000/*"
],
"content_scripts": [
    {
        "matches": ["https://open.spotify.com/*"],
        "js": [
            "core/addRecommendButton.js",
            "core/closePopup.js",
            "core/handleRecommendClick.js",
            "core/waitForSpotify.js",
            "core/observeChanges.js",
            "utils/showMessage.js",
            "utils/extractSpotifyUsername.js",
            "popup/createBasePopup.js",
            "content.js"
        ],
        "css": [
            "utils/showMessage.css",
            "popup/createBasePopup.css",
            "style.css"
        ]
    }
],
"action":{
    "default_title": "Song Recommendor"
}
}