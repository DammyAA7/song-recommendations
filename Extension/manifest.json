{
"manifest_version": 3,
"name": "Recspot",
"version": "1.0",
"description": "A Chrome extension that recommends songs to your friends based on the current song playing on Spotify.",
"permissions": [
    "activeTab",
    "scripting"
],
"host_permissions": [
    "https://open.spotify.com/*"
],

"content_scripts": [
    {
        "matches": ["https://open.spotify.com/*"],
        "js": [
            "lib/supabase.js",
            "friends/loadFriends.js",
            "friends/recommendSongToFriend.js",
            "friends/sendFriendRequest.js",
            "recommendations/sent/loadSentRecommendations.js",
            "recommendations/sent/getStatusIndicator.js",
            "recommendations/sent/SentRecsManager.js",
            "recommendations/sent//loadSentRecommendationsSmooth.js",
            "recommendations/received/setupRecommendationActions.js",
            "recommendations/received/ReceivedRecsManager.js",
            "core/addRecommendButton.js",
            "core/closePopup.js",
            "core/handleRecommendClick.js",
            "core/waitForSpotify.js",
            "core/observeChanges.js",
            "utils/showMessage.js",
            "utils/extractSpotifyUsername.js",
            "utils/getSongId.js",
            "utils/getCurrentlyPlayingSong.js",
            "utils/internetMonitor.js",
            "utils/showCommentPopup.js",
            "utils/sendComment.js",
            "utils/sendReply.js",
            "utils/friendRequestWebsocket.js",
            "utils/userId.js",
            "popup/FriendRequestsManager.js",
            "popup/createBasePopup.js",
            "popup/showPopupAuth.js",
            "popup/showPopupFriends.js",
            "popup/toggleRequestsModal.js",
            "popup/commentPopup.js",
            "auth/handleAuthFlow.js",
            "auth/checkAuthStatus.js",
            "auth/handleAuthWindow.js",
            "content.js"
        ],
        "css": [
            "core/recommendButton.css",
            "utils/showMessage.css",
            "friends/friends.css",
            "recommendations/recommendations.css",
            "popup/popup.css",
            "style.css"
        ],
        "run_at": "document_end"
    }
],
"action":{
    "default_title": "Recspot"
}
}